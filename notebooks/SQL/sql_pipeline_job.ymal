resources:
  jobs:
    ETL_pipeline_for_datalakehouse:
      name: ETL pipeline for datalakehouse
      tasks:
        - task_key: init_catalog_creation
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/init_database
            source: WORKSPACE
        - task_key: bronze_ddl
          depends_on:
            - task_key: init_catalog_creation
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/bronze/ddl_bronze
            source: WORKSPACE
        - task_key: ingest_data
          depends_on:
            - task_key: bronze_ddl
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/bronze/load_bronze
            source: WORKSPACE
        - task_key: silver_ddl
          depends_on:
            - task_key: bronze_ddl
            - task_key: ingest_data
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/silver/ddl_silver
            source: WORKSPACE
        - task_key: load_data_silver
          depends_on:
            - task_key: silver_ddl
            - task_key: ingest_data
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/silver/load_silver
            source: WORKSPACE
        - task_key: gold_view
          depends_on:
            - task_key: load_data_silver
          notebook_task:
            notebook_path: /Workspace/Users/arjunbaruwal28@gmail.com/sql_datalakehouse/notebooks/SQL/gold/ddl_gold_view
            source: WORKSPACE
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED